# Optional; the deterministic engine does not require OpenAI for production.
OPENAI_API_KEY=

# Neon Postgres. Use the pooled Neon URL for web/serverless deployments.
# Example shape:
# postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL=

# Render backend public URL, used by docs/scripts and mirrored into the frontend env.
# Example:
# https://buy-or-wait-api.onrender.com
API_BASE_URL=

# Comma-separated frontend origins allowed to call the Render FastAPI backend.
# Set this on Render after Vercel gives you the production URL.
# Example:
# https://buy-or-wait.vercel.app,https://buy-or-wait-git-main-yourteam.vercel.app
BACKEND_CORS_ORIGINS=

# Vercel frontend variable. Set this to the Render backend URL.
# Example:
# https://buy-or-wait-api.onrender.com
VITE_API_BASE_URL=
